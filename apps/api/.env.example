# NyaySahayak 2.0 API Environment Configuration Template

# Application Environment
ENVIRONMENT=development
DEBUG=true
PROJECT_NAME="NyaySahayak 2.0 API"
API_V1_PREFIX=/api/v1

# Server Bindings
HOST=0.0.0.0
PORT=8000

# CORS Allowed Origins (comma-separated)
CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"

# PostgreSQL Database URL
# For async SQLAlchemy: postgresql+psycopg://user:password@host:port/dbname or postgresql+asyncpg://...
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/nyaysahayak

# Synchronous Database URL for Alembic migrations
SYNC_DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/nyaysahayak

# Redis Configuration (Cache & Background Worker Broker)
REDIS_URL=redis://localhost:6379/0

# Object Storage (MinIO / S3)
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_NAME=nyaysahayak-documents
S3_REGION=ap-south-1

# Logging Level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO
