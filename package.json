{
  "name": "nyaysahayak-v2-monorepo",
  "version": "2.0.0",
  "private": true,
  "description": "NyaySahayak 2.0 — Verified Legal Intelligence & Courtroom Preparation Platform",
  "workspaces": [
    "apps/web"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=apps/web",
